# Copie este arquivo para .env.local e preencha.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# Google AI Studio (https://aistudio.google.com/apikey) - usada só no servidor
GEMINI_API_KEY=cole-aqui-a-chave-do-gemini
# Opcional: modelo e limite diário de sugestões por usuário
GEMINI_MODEL=gemini-3.5-flash-lite
LIMITE_SUGESTOES_DIA=50
